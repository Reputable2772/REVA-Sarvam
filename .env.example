# ==============================================================================
# FarmRoute AI — Environment Configuration Template
# Copy this file to .env and populate your active credentials:
#   cp .env.example .env
# ==============================================================================

# --- Database ---
DATABASE_URL=sqlite:///./farmroute.db

# --- Sarvam AI Voice & LLM Suite ---
# Primary API key for Saaras:v4 STT, Bulbul:v4-flash TTS, and Sarvam-105b LLM
SARVAM_API_KEY=your_sarvam_api_key_here
# Comma-separated API keys for automated key rotation and quota resilience
SARVAM_API_KEYS=your_key_1,your_key_2,your_key_3

# --- OpenStreetMap / OSRM Road Distance & Routing Service ---
# Live turn-by-turn road distance & duration calculations (No API key needed)
ENABLE_OSM_ROUTING=True
OSRM_ROUTING_URL=http://router.project-osrm.org/route/v1/driving
NOMINATIM_GEOCODING_URL=https://nominatim.openstreetmap.org/search
OSM_USER_AGENT=FarmRouteAI-Logistics/1.0

# --- Firebase Cloud Messaging (FCM Push Notifications) ---
# Path to Google Service Account JSON file for live multicast push notifications
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=reva-sarvam

# --- OpenAI-Compatible LLM Fallback (Optional) ---
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-3.5-turbo

# --- Application Mode ---
DEMO_MODE=True
